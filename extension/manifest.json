{
  "manifest_version": 3,
  "name": "Pip – prompt helper",
  "version": "0.1.0",
  "description": "A sleepy little helper that turns what's on your page into a great prompt. Pip writes prompts; you send them.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Pip",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_page": "options/options.html",
  "commands": {
    "toggle-pip": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Wake Pip or toggle its panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/errors-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/settings.js",
        "shared/pip-art.js",
        "content/context.js",
        "content/templates.js",
        "content/games/kit.js",
        "content/games/spark-catch.js",
        "content/games/vague-pop.js",
        "content/games/pip-pairs.js",
        "content/games/index.js",
        "content/panel-styles.js",
        "content/pip.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
